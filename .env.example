# Helix package template — projects use `.helix/.env` (see `helix init`).
# Copy to `.helix/.env` in a project and fill in (never commit `.helix/.env`).
# App/runtime secrets belong in the repo-root `.env`, not here.
OPENROUTER_API_KEY=

# Default model shipped with helix init (OpenRouter: xiaomi/mimo-v2.5-pro)
HELIX_MODEL=openrouter/xiaomi/mimo-v2.5-pro

# HTTP host auth stays standalone unless an external provider is selected.
# HELIX_AUTH_PROVIDER=acme-identity
# HELIX_AUTH_URL=http://127.0.0.1:8316
# HELIX_PRELUDE_TOKEN=svc_replace_me
# HELIX_ISSUES_TOKEN=svc_replace_me
# HELIX_TRUSTED_PRELUDE_ORIGINS=http://127.0.0.1:8318
# HELIX_TRUSTED_ISSUES_ORIGINS=http://127.0.0.1:8320
# Optional best-effort workflow projection to Acme Steering.
# ACME_STEERING_URL=http://127.0.0.1:8323
# ACME_STEERING_INSTANCE_ID=default
# ACME_STEERING_TOKEN=svc_replace_me
# ACME_TRUSTED_STEERING_ORIGINS=http://127.0.0.1:8323
