{
  "name": "@eimg/helix",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Experimental agent orchestration loop built on pi — not for production",
  "license": "MIT",
  "author": "Ei Maung",
  "keywords": [
    "agents",
    "orchestration",
    "pi",
    "openrouter",
    "helix",
    "experimental"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eimg/helix.git"
  },
  "bugs": {
    "url": "https://github.com/eimg/helix/issues"
  },
  "homepage": "https://github.com/eimg/helix#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "helix": "./dist/cli.js",
    "helix-dev": "./scripts/helix-dev.mjs"
  },
  "files": [
    "dist",
    "presets",
    "scripts",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "docs/plan.md",
    "docs/architecture.md",
    "docs/manage.md",
    "docs/inception-bootstrap.md",
    "docs/repo-context.md",
    "docs/guardrails.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p web/tsconfig.json && vite build && chmod +x dist/cli.js",
    "build:web": "vite build",
    "dev": "HELIX_DEV=1 tsx watch src/cli.ts serve",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node dist/cli.js serve",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "audit": "npm audit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
